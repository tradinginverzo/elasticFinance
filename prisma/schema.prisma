// Esquema de elasticFinance.
//
// Modelo mixto de datos:
// - Cada usuario tiene un espacio PERSONAL (solo él lo ve).
// - Puede pertenecer además a espacios SHARED (p. ej. "Hogar"), donde todos los miembros
//   ven y registran las mismas cuentas, transacciones y facturas.
// Todo dato financiero pertenece a un espacio (workspace_id) y guarda quién lo creó (created_by_id).
//
// Los usuarios viven en Supabase Auth (auth.users); `profiles` guarda sus datos visibles con el mismo id.
// Los montos se guardan como enteros en centavos (BigInt) junto a su moneda ISO 4217.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceKind {
  PERSONAL
  SHARED
}

enum WorkspaceRole {
  OWNER // puede invitar/quitar miembros y borrar el espacio
  MEMBER
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  SAVINGS
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER // dinero que pasa de una cuenta a otra (no es ingreso ni gasto)
}

enum ReceiptStatus {
  UPLOADED // archivo subido, sin procesar
  PROCESSING // la IA lo está leyendo
  PROCESSED // datos extraídos, pendientes de revisión
  CONFIRMED // el usuario confirmó y se creó la transacción
  FAILED // la extracción falló
}

enum CaptureSessionStatus {
  WAITING // QR mostrado en la PC, esperando la foto
  UPLOADED // el teléfono subió la foto
  COMPLETED // la PC ya la recibió
  EXPIRED
}

model Profile {
  id        String   @id @db.Uuid // = auth.users.id
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships         WorkspaceMember[]
  createdTransactions Transaction[]
  uploadedReceipts    Receipt[]
  captureSessions     CaptureSession[]
  priceEntries        PriceEntry[]
  shoppingLists       ShoppingList[]

  @@map("profiles")
}

model Workspace {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  kind      WorkspaceKind
  currency  String        @default("USD") @db.Char(3) // moneda por defecto del espacio
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  members         WorkspaceMember[]
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  templates       TransactionTemplate[]
  receipts        Receipt[]
  captureSessions CaptureSession[]
  stores          Store[]
  products        Product[]
  productAliases  ProductAlias[]
  priceEntries    PriceEntry[]
  shoppingLists   ShoppingList[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Account {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @map("workspace_id") @db.Uuid
  name                String
  type                AccountType
  currency            String      @db.Char(3)
  // Saldo que tenía la cuenta al empezar a usar la app.
  // Saldo actual = inicial + ingresos − gastos − transferencias enviadas + transferencias recibidas.
  initialBalanceCents BigInt      @default(0) @map("initial_balance_cents")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz

  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions      Transaction[]         @relation("TransactionAccount")
  incomingTransfers Transaction[]         @relation("TransferToAccount")
  templates         TransactionTemplate[]

  @@index([workspaceId])
  @@map("accounts")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String
  type        TransactionType
  icon        String?
  color       String?

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  templates    TransactionTemplate[]

  @@unique([workspaceId, name, type])
  @@map("categories")
}

model Transaction {
  id                  String          @id @default(uuid()) @db.Uuid
  workspaceId         String          @map("workspace_id") @db.Uuid
  createdById         String          @map("created_by_id") @db.Uuid
  accountId           String          @map("account_id") @db.Uuid // en transferencias: cuenta de origen
  toAccountId         String?         @map("to_account_id") @db.Uuid // solo transferencias: cuenta de destino
  categoryId          String?         @map("category_id") @db.Uuid
  type                TransactionType
  amountCents         BigInt          @map("amount_cents") // siempre positivo; el signo lo da `type`
  currency            String          @db.Char(3)
  date                DateTime        @db.Date
  merchant            String?
  notes               String?
  templateId          String?         @map("template_id") @db.Uuid // gasto fijo del que salió, si lo hay
  // Monto habitual del gasto fijo al registrarlo: para marcar si este mes fue distinto
  // sin que un cambio posterior del monto habitual altere los meses anteriores.
  templateAmountCents BigInt?         @map("template_amount_cents")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Profile              @relation(fields: [createdById], references: [id])
  template  TransactionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  account   Account              @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount Account?             @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  category  Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receipts  Receipt[]

  @@index([workspaceId, date(sort: Desc)])
  @@index([templateId, date])
  @@index([toAccountId])
  @@map("transactions")
}

// Gasto (o ingreso) fijo guardado: alquiler, luz, sueldo… Sirve de plantilla para
// registrar el movimiento de cada mes; el monto se puede cambiar al registrarlo.
model TransactionTemplate {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String
  type        TransactionType
  amountCents BigInt          @map("amount_cents") // monto habitual
  accountId   String?         @map("account_id") @db.Uuid
  categoryId  String?         @map("category_id") @db.Uuid
  merchant    String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([workspaceId])
  @@map("transaction_templates")
}

model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  uploadedById  String        @map("uploaded_by_id") @db.Uuid
  transactionId String?       @map("transaction_id") @db.Uuid
  storagePath   String        @map("storage_path") // ruta dentro del bucket privado "receipts"
  mimeType      String        @map("mime_type")
  sizeBytes     Int           @map("size_bytes")
  status        ReceiptStatus @default(UPLOADED)
  extractedData Json?         @map("extracted_data") // lo que devolvió la IA
  error         String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy     Profile         @relation(fields: [uploadedById], references: [id])
  transaction    Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  captureSession CaptureSession?
  priceEntries   PriceEntry[]
  // Cuándo se guardaron en el comparador los productos leídos de esta factura.
  itemsSavedAt   DateTime?       @map("items_saved_at") @db.Timestamptz

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("receipts")
}

// Sesión para subir una factura desde el teléfono escaneando un QR en la PC.
model CaptureSession {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid // espacio donde se guardará la factura
  userId      String               @map("user_id") @db.Uuid
  tokenHash   String               @unique @map("token_hash") // nunca guardamos el token en claro
  status      CaptureSessionStatus @default(WAITING)
  receiptId   String?              @unique @map("receipt_id") @db.Uuid
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt   Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("capture_sessions")
}

// ─── Comparador de precios y lista de compras ────────────────────────────────────────────
// Un producto es lo que se compara ("Detergente líquido"); cada precio visto guarda la marca
// y la medida concretas ("Deja 1 L"). Para comparar se usa el precio por unidad base (ml, g o
// unidad), así 1 L se compara con 2 × 500 ml.

enum ProductUnit {
  ML // líquidos: se muestran en ml / L
  G // sólidos: g / kg
  UNIT // unidades: rollos, huevos…
}

enum PriceSource {
  MANUAL // escrito en el comparador
  SHOPPING // marcado en la lista de compras, en el súper
  RECEIPT // leído de una factura
}

model Store {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priceEntries  PriceEntry[]
  shoppingLists ShoppingList[]

  @@unique([workspaceId, name])
  @@map("stores")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String
  unit        ProductUnit
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aliases       ProductAlias[]
  priceEntries  PriceEntry[]
  shoppingItems ShoppingListItem[]

  @@unique([workspaceId, name])
  @@map("products")
}

// Cómo aparece un producto en las facturas ("DET LIQ DEJA 1000ML"), para reconocerlo
// en las siguientes sin preguntar.
model ProductAlias {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  text        String // en mayúsculas y sin espacios repetidos
  productId   String  @map("product_id") @db.Uuid
  // Lo último confirmado para esa línea: las facturas (p. ej. Supermaxi) no siempre traen la medida.
  brand       String?
  sizeEach    Float?  @map("size_each")
  packCount   Int?    @map("pack_count")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, text])
  @@map("product_aliases")
}

// Precio de UN paquete de un producto en un supermercado, un día.
model PriceEntry {
  id                String      @id @default(uuid()) @db.Uuid
  workspaceId       String      @map("workspace_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  createdById       String      @map("created_by_id") @db.Uuid
  brand             String?
  description       String? // texto de la factura o nota
  sizeEach          Float       @map("size_each") // medida de cada unidad del paquete, en la unidad base del producto
  packCount         Int         @default(1) @map("pack_count") // unidades en el paquete ("3 × 400 g")
  priceCents        BigInt      @map("price_cents") // lo que cuesta el paquete (con la oferta, si hay)
  regularPriceCents BigInt?     @map("regular_price_cents") // precio normal, si estaba en oferta y se conoce
  onSale            Boolean     @default(false) @map("on_sale")
  source            PriceSource
  receiptId         String?     @map("receipt_id") @db.Uuid
  date              DateTime    @db.Date
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy    Profile           @relation(fields: [createdById], references: [id])
  receipt      Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  shoppingItem ShoppingListItem?

  @@index([productId, date(sort: Desc)])
  @@index([receiptId])
  @@map("price_entries")
}

model ShoppingList {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  name        String
  storeId     String?   @map("store_id") @db.Uuid // dónde se está comprando
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Profile            @relation(fields: [createdById], references: [id])
  store     Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items     ShoppingListItem[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id           String    @id @default(uuid()) @db.Uuid
  listId       String    @map("list_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  note         String? // "el grande", "sin lactosa"…
  quantity     Int       @default(1) // paquetes que se llevan
  priceEntryId String?   @unique @map("price_entry_id") @db.Uuid // precio marcado en el súper
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz // ya está en el carrito
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  list       ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceEntry PriceEntry?  @relation(fields: [priceEntryId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@map("shopping_list_items")
}
